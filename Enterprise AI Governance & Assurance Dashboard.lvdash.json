{
  "datasets": [
    {
      "name": "4fe8066e",
      "displayName": "Portfolio overview",
      "queryLines": [
        "SELECT\r\n",
        "    u.use_case_id,\r\n",
        "    u.org_name,\r\n",
        "    u.industry,\r\n",
        "    u.ai_technique,\r\n",
        "    u.disclosure_type,\r\n",
        "    ROUND(AVG(r.score_1_5), 1) AS avg_risk_score,\r\n",
        "    MAX(r.score_1_5) AS highest_dimension_score\r\n",
        "FROM use_case_inventory.ai_use_cases u\r\n",
        "JOIN risk_assessment.risk_scores r ON u.use_case_id = r.use_case_id\r\n",
        "GROUP BY u.use_case_id, u.org_name, u.industry, u.ai_technique, u.disclosure_type\r\n",
        "ORDER BY avg_risk_score DESC;"
      ],
      "catalog": "ai_governance",
      "schema": "default"
    },
    {
      "name": "896cdb39",
      "displayName": "Risk distribution by dimension",
      "queryLines": [
        "SELECT\r\n",
        "    dimension,\r\n",
        "    ROUND(AVG(score_1_5), 1) AS avg_score,\r\n",
        "    MIN(score_1_5) AS min_score,\r\n",
        "    MAX(score_1_5) AS max_score,\r\n",
        "    SUM(CASE WHEN risk_data_source = 'disclosed' THEN 1 ELSE 0 END) AS disclosed_count,\r\n",
        "    SUM(CASE WHEN risk_data_source = 'inferred_by_assessor' THEN 1 ELSE 0 END) AS inferred_count\r\n",
        "FROM risk_assessment.risk_scores\r\n",
        "GROUP BY dimension\r\n",
        "ORDER BY avg_score DESC;"
      ],
      "catalog": "ai_governance",
      "schema": "default"
    },
    {
      "name": "4faa9dae",
      "displayName": "Control implementation coverage",
      "queryLines": [
        "SELECT\r\n",
        "    use_case_id,\r\n",
        "    COUNT(*) AS total_controls_assessed,\r\n",
        "    SUM(CASE WHEN implementation_status = 'implemented' THEN 1 ELSE 0 END) AS implemented,\r\n",
        "    SUM(CASE WHEN implementation_status = 'partial' THEN 1 ELSE 0 END) AS partial,\r\n",
        "    SUM(CASE WHEN implementation_status = 'not_implemented' THEN 1 ELSE 0 END) AS not_implemented,\r\n",
        "    ROUND(\r\n",
        "        SUM(CASE WHEN implementation_status = 'implemented' THEN 1 ELSE 0 END) * 100.0\r\n",
        "        / NULLIF(SUM(CASE WHEN implementation_status != 'not_applicable' THEN 1 ELSE 0 END), 0), 0\r\n",
        "    ) AS pct_implemented\r\n",
        "FROM controls.use_case_controls\r\n",
        "GROUP BY use_case_id\r\n",
        "ORDER BY pct_implemented ASC;\r\n"
      ],
      "catalog": "ai_governance",
      "schema": "default"
    },
    {
      "name": "700aba2d",
      "displayName": "ISO 42001 maturity heat map",
      "queryLines": [
        "SELECT\r\n",
        "    use_case_id,\r\n",
        "    domain,\r\n",
        "    maturity_score_0_4\r\n",
        "FROM readiness.iso42001_maturity\r\n",
        "ORDER BY use_case_id, domain;"
      ],
      "catalog": "ai_governance",
      "schema": "default"
    },
    {
      "name": "c3834dcd",
      "displayName": "Open risk register -- inherent vs residual rating",
      "queryLines": [
        "SELECT\r\n",
        "    risk_id,\r\n",
        "    use_case_id,\r\n",
        "    dimension,\r\n",
        "    inherent_rating,\r\n",
        "    residual_rating,\r\n",
        "    mitigation_action,\r\n",
        "    review_date\r\n",
        "FROM risk_register.risks\r\n",
        "ORDER BY\r\n",
        "    CASE inherent_rating WHEN 'Critical' THEN 4 WHEN 'High' THEN 3 WHEN 'Medium' THEN 2 ELSE 1 END DESC;"
      ],
      "catalog": "ai_governance",
      "schema": "default"
    },
    {
      "name": "f8078d63",
      "displayName": "Source quality mix",
      "queryLines": [
        "SELECT\r\n",
        "    disclosure_type,\r\n",
        "    COUNT(*) AS use_case_count\r\n",
        "FROM use_case_inventory.ai_use_cases\r\n",
        "GROUP BY disclosure_type\r\n",
        "ORDER BY use_case_count DESC;"
      ],
      "catalog": "ai_governance",
      "schema": "default"
    },
    {
      "name": "45bf277f",
      "displayName": "Guardrail Test Results by OWASP Category",
      "queryLines": [
        "SELECT\r\n",
        "    owasp_category,\r\n",
        "    COUNT(*) AS total_tests,\r\n",
        "    SUM(CASE WHEN guardrail_triggered THEN 1 ELSE 0 END) AS guardrail_fired,\r\n",
        "    SUM(CASE WHEN model_response_blocked THEN 1 ELSE 0 END) AS blocked\r\n",
        "FROM ai_governance.risk_assessment.guardrail_evaluations\r\n",
        "GROUP BY owasp_category\r\n",
        "ORDER BY owasp_category"
      ]
    },
    {
      "name": "eaaa2dd9",
      "displayName": "Enterprise AI Governance KPIs",
      "queryLines": [
        "SELECT\r\n",
        "    /* Risk Assessment KPIs */\r\n",
        "    COUNT(DISTINCT rs.use_case_id) AS ai_systems_assessed,\r\n",
        "    COUNT(rs.score_id) AS risk_assessments_completed,\r\n",
        "    ROUND(AVG(rs.score_1_5), 2) AS avg_portfolio_risk_score,\r\n",
        "\r\n",
        "    /* Assurance KPIs */\r\n",
        "    (\r\n",
        "        SELECT ROUND(\r\n",
        "            100 *\r\n",
        "            SUM(\r\n",
        "                CASE\r\n",
        "                    WHEN attack_success_flag = FALSE\r\n",
        "                         AND owasp_category <> 'control'\r\n",
        "                    THEN 1\r\n",
        "                    ELSE 0\r\n",
        "                END\r\n",
        "            )\r\n",
        "            /\r\n",
        "            SUM(\r\n",
        "                CASE\r\n",
        "                    WHEN owasp_category <> 'control'\r\n",
        "                    THEN 1\r\n",
        "                    ELSE 0\r\n",
        "                END\r\n",
        "            ),\r\n",
        "            1\r\n",
        "        )\r\n",
        "        FROM ai_governance.risk_assessment.guardrail_evaluations\r\n",
        "    ) AS control_effectiveness_pct,\r\n",
        "\r\n",
        "    (\r\n",
        "        SELECT COUNT(*)\r\n",
        "        FROM ai_governance.risk_assessment.guardrail_evaluations\r\n",
        "        WHERE attack_success_flag = TRUE\r\n",
        "    ) AS control_failures,\r\n",
        "\r\n",
        "    (\r\n",
        "        SELECT COUNT(DISTINCT owasp_category)\r\n",
        "        FROM ai_governance.risk_assessment.guardrail_evaluations\r\n",
        "        WHERE owasp_category <> 'control'\r\n",
        "    ) AS owasp_categories_covered\r\n",
        "\r\n",
        "FROM ai_governance.risk_assessment.risk_scores rs;"
      ],
      "catalog": "ai_governance",
      "schema": "risk_assessment"
    },
    {
      "name": "cf2d39be",
      "displayName": "AI Assurance Metrics",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN attack_success_flag = FALSE\r\n",
        "                 AND owasp_category <> 'control'\r\n",
        "            THEN 1\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS controls_effective,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN attack_success_flag = TRUE\r\n",
        "            THEN 1\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS control_failures,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN owasp_category <> 'control'\r\n",
        "            THEN 1\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS adversarial_tests,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        CASE\r\n",
        "            WHEN owasp_category = 'control'\r\n",
        "            THEN 1\r\n",
        "            ELSE 0\r\n",
        "        END\r\n",
        "    ) AS control_tests,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        100 *\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN attack_success_flag = FALSE\r\n",
        "                     AND owasp_category <> 'control'\r\n",
        "                THEN 1\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        )\r\n",
        "        /\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN owasp_category <> 'control'\r\n",
        "                THEN 1\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ),\r\n",
        "        1\r\n",
        "    ) AS control_effectiveness_pct,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "        100 *\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN attack_success_flag = TRUE\r\n",
        "                THEN 1\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        )\r\n",
        "        /\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN owasp_category <> 'control'\r\n",
        "                THEN 1\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ),\r\n",
        "        1\r\n",
        "    ) AS attack_success_rate_pct\r\n",
        "\r\n",
        "FROM ai_governance.risk_assessment.guardrail_evaluations;"
      ]
    },
    {
      "name": "b66185e1",
      "displayName": "Governance Framework Traceability Matrix Show more lines",
      "queryLines": [
        "SELECT DISTINCT\r\n",
        "    owasp_category,\r\n",
        "    nist_control,\r\n",
        "    iso_control,\r\n",
        "    privacy_framework\r\n",
        "FROM ai_governance.risk_assessment.guardrail_evaluations\r\n",
        "WHERE owasp_category <> 'control'\r\n",
        "ORDER BY owasp_category;"
      ]
    },
    {
      "name": "e01cb692",
      "displayName": "AI Governance Assurance Summary",
      "queryLines": [
        "SELECT CONCAT(\r\n",
        "    ROUND(\r\n",
        "        100 *\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN attack_success_flag = FALSE\r\n",
        "                     AND owasp_category <> 'control'\r\n",
        "                THEN 1\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        )\r\n",
        "        /\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN owasp_category <> 'control'\r\n",
        "                THEN 1\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ),\r\n",
        "        1\r\n",
        "    ),\r\n",
        "    '%'\r\n",
        ") AS control_effectiveness\r\n",
        "FROM ai_governance.risk_assessment.guardrail_evaluations;"
      ]
    }
  ],
